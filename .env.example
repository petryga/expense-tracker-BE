DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_HOST=127.0.0.1
# Leave blank locally (defaults to 5432). Set explicitly for hosted Postgres,
# e.g. Supabase's connection pooler uses 6543, the direct connection uses 5432.
DB_PORT=

# Comma-separated list of origins allowed to call this API (CORS). Defaults to
# the local Vite dev server if unset. Set this to your deployed frontend's URL
# in production (e.g. https://your-app.vercel.app).
CORS_ORIGIN=http://localhost:5173

# Supabase project auth. Default verification mode is 'jwks' (asymmetric ES256/RS256,
# used by newer Supabase projects) which only needs SUPABASE_URL to fetch
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json.
# Set SUPABASE_JWT_VERIFICATION_MODE=hs256 to fall back to the legacy shared-secret
# verification instead (requires SUPABASE_JWT_SECRET from Settings -> API -> JWT Secret).
SUPABASE_URL=
SUPABASE_JWT_VERIFICATION_MODE=jwks
SUPABASE_JWT_SECRET=

# Supabase user id of the "demo" account (Authentication -> Users in the Supabase
# dashboard). When set, that account's data is wiped and reseeded with fresh fake
# data every time it logs in. Leave blank to disable — the feature is a no-op
# for every account when unset.
DEMO_USER_ID=
