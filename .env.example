# ── Database (Postgres) ──────────────────────────────────────────────
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=127.0.0.1
# Leave blank locally (defaults to 5432). Hosted Postgres: Supabase's pooler
# is 6543, the direct connection is 5432.
DB_PORT=
# Full TLS cert verification against the DB. Off by default because Supabase
# serves Postgres behind a CA node doesn't trust out of the box (the
# connection is still encrypted). Set to "true" once that CA is trusted.
DB_SSL_REJECT_UNAUTHORIZED=false

# ── Auth (Supabase) ─────────────────────────────────────────────────
# Set SUPABASE_URL to enable JWT auth. It's the only var the default
# verification mode (jwks) needs — the API fetches
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=
SUPABASE_JWT_VERIFICATION_MODE=jwks
# Only for the legacy hs256 mode (Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=
# Run WITHOUT auth on purpose (local dev, CI). Without this and without
# SUPABASE_URL the API fails closed with a 500 instead of serving every
# request as a shared anonymous user.
AUTH_DISABLED=true

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Comma-separated list of origins allowed by CORS. Defaults to the local
# Vite dev server. Set to the deployed frontend URL in production.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# ── Demo account (optional) ─────────────────────────────────────────
# Supabase user id of the "demo" account. When set, that account's data is
# wiped and reseeded with fresh fake data on every login. Leave blank to
# disable (no-op for every account).
DEMO_USER_ID=
