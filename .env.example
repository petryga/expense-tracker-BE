# ── Database (Postgres) ──────────────────────────────────────────────
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=127.0.0.1
# Leave blank locally (defaults to 5432). Hosted Postgres: Supabase's pooler
# is 6543, the direct connection is 5432.
DB_PORT=
# Full TLS cert verification against the DB. Off by default because Supabase
# serves Postgres behind a CA node doesn't trust out of the box (the
# connection is still encrypted). Set to "true" once that CA is trusted.
DB_SSL_REJECT_UNAUTHORIZED=false

# ── Auth (Supabase) ─────────────────────────────────────────────────
# Set SUPABASE_URL to enable JWT auth. It's the only var the default
# verification mode (jwks) needs — the API fetches
# https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=
SUPABASE_JWT_VERIFICATION_MODE=jwks
# Only for the legacy hs256 mode (Settings → API → JWT Secret).
SUPABASE_JWT_SECRET=
# Run WITHOUT auth on purpose (local dev, CI). Without this and without
# SUPABASE_URL the API fails closed with a 500 instead of serving every
# request as a shared anonymous user.
AUTH_DISABLED=true

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Comma-separated list of origins allowed by CORS. Defaults to the local
# Vite dev server. Set to the deployed frontend URL in production.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# ── Demo account (optional) ─────────────────────────────────────────
# Supabase user id of the "demo" account. When set, that account's data is
# wiped and reseeded with fresh fake data on every login. Leave blank to
# disable (no-op for every account).
DEMO_USER_ID=

# Local dev only: set to true to turn off the API rate limit.
# RATE_LIMIT_DISABLED=false

# ── Logging ─────────────────────────────────────────────────────────
# pino level: fatal, error, warn, info (default), debug, trace, silent.
LOG_LEVEL=info
# Local dev only: human-readable logs instead of JSON lines.
# LOG_PRETTY=true

# ── Error tracking (Sentry) ─────────────────────────────────────────
# Off unless set. 5xx errors are reported with type, stack, method, route and
# request id only: no bodies, headers, cookies, query strings, IPs or user ids.
# SENTRY_DSN=
# Defaults to NODE_ENV, else development. Set it to production on Northflank,
# which does not set NODE_ENV in the container.
# SENTRY_ENVIRONMENT=
# Optional: a release name, e.g. the git commit, to group errors by deploy.
# SENTRY_RELEASE=

# ── Statement import ────────────────────────────────────────────────
# File upload is on whenever AUTH_DISABLED=true (local use). In production it
# stays off unless this is "true"; the demo account never uploads, it only gets
# the bundled synthetic sample statement.
# STATEMENT_UPLOAD_ENABLED=false

# ── AI category suggestions (Plan 3, Phase B) ───────────────────────
# Off unless "true" and both URL and secret are set. The secret must match
# AI_SHARED_SECRET in AI/.env. Any failure or timeout imports rows without
# suggestions.
# AI_CATEGORIZE_ENABLED=false
# AI_SERVICE_URL=http://localhost:8000
# AI_SHARED_SECRET=
# AI_TIMEOUT_MS=8000
# Rows a user may send for suggestions per day; over it, rows get none.
# AI_CATEGORIZE_DAILY_ROWS=2000

# The spending assistant (chat page): questions go to the AI service's /ask,
# which reads the user's data through the MCP server. Off by default; never
# offered to the demo user. Uses AI_SERVICE_URL and AI_SHARED_SECRET above.
# AI_ASSISTANT_ENABLED=false
# AI_ASSISTANT_DAILY_LIMIT=50
