{
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["es2020", "dom"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2020",
    "inlineSourceMap": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "allowJs": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": true,
    "plugins": []
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
