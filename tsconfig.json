{
  "ts-node": {
    "compiler": "ttypescript"
  },
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["es2020", "dom"],
    "module": "commonjs",
    "target": "es2019",
    "inlineSourceMap": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "allowJs": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noErrorTruncation": true,
    "plugins": []
  }
}
